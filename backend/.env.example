# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/otakuplay?retryWrites=true&w=majority

# JWT Secrets (Generate strong 64-byte random hex strings in production)
JWT_ACCESS_SECRET=replace-with-secure-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-secure-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Optional Redis (Caching & Presence)
REDIS_URL=

# External Upstream APIs
ANIMASU_BASE_URL=https://api.nexadev.my.id/animasu
SNAPTIK_BASE_URL=https://api.nexadev.my.id/api/snaptik/
OTAKU_AI_BASE_URL=https://api.nexadev.my.id/ai/chatgptpro
KOMPAS_NEWS_URL=https://api.nexadev.my.id/api/kompasnews

# Upload Settings
MAX_UPLOAD_MB=25
UPLOAD_DIR=uploads

# Bootstrap Super Admin (optional, used by migration script)
SUPER_ADMIN_EMAIL=admin@otakuplay.app
SUPER_ADMIN_USERNAME=otaku_admin
SUPER_ADMIN_PASSWORD=ChangeMeStrongPassword123!
