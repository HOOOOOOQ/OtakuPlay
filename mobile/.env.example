# OtakuPlay Mobile Environment Example
# Copy to .env (ignored by Git) or pass via --dart-define in release builds.

API_BASE_URL=https://api.otakuplay.app/api/v1
SOCKET_URL=https://api.otakuplay.app
GOOGLE_SERVER_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
ANIMASU_DIRECT_FALLBACK=false
